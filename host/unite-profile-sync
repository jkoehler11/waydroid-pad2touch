#!/bin/bash
# Pull the Unite Mapper app profile over adb and apply it to pad2touch.
#
# The app's profile lives in app-private external storage, which the host cannot
# read directly (Android/data is uid-restricted), so it is fetched with adb.
set -u
ADB="adb -s 192.168.240.112:5555"
SRC=/sdcard/Android/data/com.koehler.unitemapper/files/unite_profile.json
STAMP=/run/unite-profile.sha

json=$($ADB shell cat "$SRC" 2>/dev/null | tr -d '\r')
[ -z "$json" ] && { echo "no profile yet"; exit 0; }

sum=$(printf '%s' "$json" | sha256sum | cut -d' ' -f1)
if [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$sum" ]; then
    exit 0                       # unchanged
fi
printf '%s\n' "$sum" > "$STAMP"

python3 - "$json" <<'PY'
import json, sys
prof = json.loads(sys.argv[1])
# map app labels -> daemon config keys BY MEANING (the daemon keeps the Switch
# layout: LB = move 1, RB = move 2, X = score, Y = battle item, LT = unite)
pairs = [
    ("move",   "move_cx",  "move_cy"),
    ("a",      "a_x",      "a_y"),      # basic attack
    ("x",      "lb_x",     "lb_y"),     # Ice Shard  -> LB (move 1)
    ("b",      "rb_x",     "rb_y"),     # Whirlpool  -> RB (move 2)
    ("y",      "y_x",      "y_y"),      # battle item -> Y
    ("lb",     "x_x",      "x_y"),      # score      -> X
    ("lt",     "select_x", "select_y"), # Unite Move -> LT
    ("camera", "camera_cx","camera_cy"),
]
out = ["# generated by unite-profile-sync from the Unite Mapper app",
       "width = 2560", "height = 1396", ""]
for src, kx, ky in pairs:
    if f"{src}_x" in prof and f"{src}_y" in prof:
        out += [f"{kx} = {int(prof[f'{src}_x'])}", f"{ky} = {int(prof[f'{src}_y'])}"]
out.append(f"move_radius = {int(prof.get('radius', 120))}")
out += [
    "deadzone = 0.18",
    "camera_deadzone = 0.25",
    "camera_range = 220",
    "b_x = -1", "b_y = -1",              # B = cancel move: no touch equivalent
    "start_x = -1", "start_y = -1",      # Start = menu: not measured
    "lb_w = 0", "lb_h = 0", "rb_w = 0", "rb_h = 0",
]
open("/etc/pad2touch.conf", "w").write("\n".join(out) + "\n")
print("wrote /etc/pad2touch.conf")
PY
if systemctl restart pad2touch.service 2>/dev/null; then
    echo "pad2touch restarted"
    sleep 3
    /usr/local/bin/pad2touch-inject && echo "touchscreen re-injected"
fi
