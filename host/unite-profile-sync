#!/bin/bash
# Pull the Unite Mapper profile over adb, size it to the live display, and apply
# it to pad2touch (restart + re-inject the touch device).
set -eu
ADB="adb -s 192.168.240.112:5555"
SRC=/sdcard/Android/data/com.koehler.unitemapper/files/unite_profile.json
STAMP=/run/unite-profile.sha

json=$($ADB shell cat "$SRC" 2>/dev/null | tr -d '\r')
[ -z "$json" ] && { echo "no profile yet"; exit 0; }

# The Waydroid window can be resized: the touch device must match the real
# surface, or coordinates are scaled (1366 vs 1396 = ~26 px at the bottom).
size=$($ADB shell wm size 2>/dev/null | tr -d '\r' | grep -o '[0-9]\+x[0-9]\+' | tail -1)
W=${size%x*}; H=${size#*x}
[ -z "${W:-}" ] && W=2560
[ -z "${H:-}" ] && H=1396

sum=$(printf '%s%s' "$json" "$size" | sha256sum | cut -d' ' -f1)
if [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$sum" ]; then
    exit 0
fi
printf '%s\n' "$sum" > "$STAMP"

python3 - "$json" "$W" "$H" <<'PY'
import json, sys
prof = json.loads(sys.argv[1]); W, H = sys.argv[2], sys.argv[3]
# app labels -> daemon keys, by meaning (daemon keeps the switch layout:
# LB = move 1, RB = move 2, X = score, Y = battle item, LT = unite)
pairs = [
    ("move",   "move_cx",   "move_cy"),
    ("a",      "a_x",       "a_y"),
    ("x",      "lb_x",      "lb_y"),
    ("b",      "rb_x",      "rb_y"),
    ("y",      "y_x",       "y_y"),
    ("lb",     "x_x",       "x_y"),
    ("lt",     "select_x",  "select_y"),
    ("recall", "recall_x", "recall_y"),
    ("camera", "camera_cx", "camera_cy"),
]
out = ["# generated by unite-profile-sync from the Unite Mapper app",
       f"width = {W}", f"height = {H}", ""]
for src, kx, ky in pairs:
    if f"{src}_x" in prof and f"{src}_y" in prof:
        out += [f"{kx} = {int(prof[f'{src}_x'])}", f"{ky} = {int(prof[f'{src}_y'])}"]
# app action -> daemon slot (same meaning-mapping used for coordinates)
BIND_SLOTS = {"a": "a", "b": "rb", "x": "lb", "y": "y", "lb": "x",
              "lt": "select", "recall": "recall"}
for _ak, _slot in BIND_SLOTS.items():
    _b = prof.get("bind_" + _ak)
    if _b:
        out.append(f"bind_{_slot} = {str(_b).upper()}")
out += [f"move_radius = {int(prof.get('radius', 120))}",
        "deadzone = 0.18", "camera_deadzone = 0.25", "camera_range = 220",
        "b_x = -1", "b_y = -1", "start_x = -1", "start_y = -1",
        "lb_w = 0", "lb_h = 0", "rb_w = 0", "rb_h = 0"]
open("/etc/pad2touch.conf", "w").write("\n".join(out) + "\n")
print(f"wrote /etc/pad2touch.conf ({W}x{H})")
PY

if systemctl restart pad2touch.service 2>/dev/null; then
    echo "pad2touch restarted"
    sleep 3
    /usr/local/bin/pad2touch-inject && echo "touchscreen re-injected"
fi
