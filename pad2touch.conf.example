# pad2touch configuration — copy to /etc/pad2touch.conf
#
# Normally you never edit this by hand: the Unite Mapper app writes a JSON profile
# and unite-profile-sync turns it into this file every 20 s, then restarts the
# daemon. This file is a reference, or a starting point for a manual install.
#
# Everything here is game- and resolution-specific. The values below were captured
# on a 2560x1366 Waydroid surface during a Pokemon UNITE match.

# Live surface size. Must match what Android reports (`wm size`) or every y
# coordinate is scaled wrong; unite-profile-sync sets this automatically.
width = 2560
height = 1366

# ---------------------------------------------------------------- touch targets
# One x/y pair per control. A value of -1 disables that slot (no touch emitted).
a_x = 2335
a_y = 1169
b_x = 2079
b_y = 944
x_x = 1925
x_y = 1192
y_x = 1728
y_y = 1019
lb_x = 1589
lb_y = 1208
lt_x = 2338
lt_y = 792
recall_x = 1384
recall_y = 1200

# ------------------------------------------------------------- movement stick
# Centre of the floating joystick and how far a full tilt drags the finger.
# Too small and full deflection falls inside the game's deadzone (movement dies);
# too large and the character overshoots the ring.
move_cx = 358
move_cy = 1070
move_radius = 120
deadzone = 0.18

# --------------------------------------------------- camera (right stick)
# A drag starting here pans the camera. Point it at open playfield.
camera_cx = 2107
camera_cy = 660
camera_range = 220
camera_deadzone = 0.25

# ------------------------------------------------------------------- bindings
# Which physical button fires which control. Accepted values (case-insensitive):
#   A  B  X  Y  LB  RB  LT  RT  START  BACK
# Omit a bind (or set it to none) to disable that control. LT/RT work whether the
# pad reports them as analog triggers or as digital buttons.
bind_a = B
bind_b = RT
bind_x = RB
bind_y = X
bind_lb = Y
bind_lt = LT
bind_recall = BACK

# Start is not used by UNITE; -1 disables it.
start_x = -1
start_y = -1
